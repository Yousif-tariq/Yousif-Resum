# ==============================================================================
# Django Quantum Core Gateway - Production & Render Configuration
# ==============================================================================

# 1. Security & Core Settings
DJANGO_SECRET_KEY=quantum-super-secret-production-key-change-this-now
DEBUG=False
ALLOWED_HOSTS=.onrender.com,localhost,127.0.0.1

# 2. Database Options:
# Option A: Turso Cloud Database (libSQL) - [RECOMMENDED]
TURSO_DATABASE_URL=https://resueem-yousif249x.aws-ap-south-1.turso.io
TURSO_AUTH_TOKEN=your-turso-jwt-auth-token-here

# Option B: PostgreSQL (e.g. Render Postgres)
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Option C: Local SQLite (Leave TURSO and DATABASE_URL empty)

# 3. Initial Superuser Provisioning (Auto-created during build if not exists)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=your-strong-password-here
DJANGO_SUPERUSER_EMAIL=yousif.tariq@engineer.dev
